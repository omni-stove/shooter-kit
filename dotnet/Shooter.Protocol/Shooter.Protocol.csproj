<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity の Shooter.Protocol アセンブリ (Assets/kits/shooter/Scripts/Protocol) を Unity 抜きでビルドする。ソースは Assets 側が正 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GameKit.Net/GameKit.Net.csproj" />
    <ProjectReference Include="../Shooter.Core/Shooter.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/kits/shooter/Scripts/Protocol/**/*.cs" />
  </ItemGroup>
</Project>
