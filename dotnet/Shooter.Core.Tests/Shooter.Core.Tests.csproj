<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shooter.Core/Shooter.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Unity の EditMode テスト (Assets/kits/shooter/Tests/EditMode/Core) も同じソースで dotnet test から回す -->
    <Compile Include="../../Assets/kits/shooter/Tests/EditMode/Core/**/*.cs" Link="EditMode/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- 弾道や誘導のテストも地形の代役を使うので、game-kit のテストと同じものをリンクして共有する -->
    <Compile Include="../GameKit.Core.Tests/FakeWorldCollision.cs" Link="GameKit/FakeWorldCollision.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
</Project>
