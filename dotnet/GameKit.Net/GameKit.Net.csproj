<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity の GameKit.Net アセンブリ (Assets/kits/core/Scripts/Net) を Unity 抜きでビルドする。ソースは Assets 側が正 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unity 側 (Assets/Plugins/LiteNetLib/LiteNetLib.dll。この版の netstandard2.1 の DLL を写したもの) と同じ版にそろえる -->
    <PackageReference Include="LiteNetLib" Version="2.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/kits/core/Scripts/Net/**/*.cs" />
  </ItemGroup>
</Project>
