<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity の Shooter.Core アセンブリ (Assets/kits/shooter/Scripts/Core) を Unity 抜きでビルドする。ソースは Assets 側が正 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/kits/shooter/Scripts/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GameKit.Core/GameKit.Core.csproj" />
  </ItemGroup>
</Project>
